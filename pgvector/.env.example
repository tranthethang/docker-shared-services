# Standalone PostgreSQL 17 + pgvector extension.
# Separate from the default "postgres" (16) service. Shared backend for
# Hindsight (database `hindsight`); also available for your own workloads.
# Uses port 5433 on the host to avoid clashing with Postgres 16 on 5432.
RESTART_POLICY=unless-stopped
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=Password102!
PGVECTOR_DB=postgres
PGVECTOR_PORT=5433
PGVECTOR_CPUS_LIMIT=0.5
PGVECTOR_MEMORY_LIMIT=512M
PGVECTOR_CPUS_RESERVED=0.1
PGVECTOR_MEMORY_RESERVED=128M
