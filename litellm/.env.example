RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# Pin ghcr.io/berriai/litellm (do not use latest or main-stable).
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6
LITELLM_HOSTNAME=litellm.dss.localhost

# Shared PostgreSQL 16 (postgres/docker-compose.yml) on data_net.
# Database `litellm` is created by postgres/bin/init.sh on a new volume.
# An existing Postgres volume does not re-run init. Create it once:
#   docker exec postgres psql -U postgres -c "CREATE DATABASE litellm;"
POSTGRES16_PASSWORD=

# Admin UI login user is `admin`. The password is LITELLM_MASTER_KEY.
# UI:  https://litellm.dss.localhost/ui
# API: https://litellm.dss.localhost/v1
# LITELLM_SALT_KEY encrypts provider API keys stored in the database.
# Changing the salt makes previously stored provider keys unreadable.
# `make setup` fills empty values (32-byte hex). Leave them empty.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

LITELLM_CPUS_LIMIT=1.0
LITELLM_MEMORY_LIMIT=1G
LITELLM_CPUS_RESERVED=0.1
LITELLM_MEMORY_RESERVED=256M
