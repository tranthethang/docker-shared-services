RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# Pin ghcr.io/berriai/litellm:v1.111.0 (do not use latest or main-stable).
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.111.0
# Default: litellm.${DOMAIN}
LITELLM_HOSTNAME=

# Shared PostgreSQL 16 (postgres/docker-compose.yml) on data_net.
# Database `litellm` is created by postgres/bin/init.sh on a new volume.
# An existing Postgres volume does not re-run init. Create it once:
#   docker exec postgres psql -U postgres -c "CREATE DATABASE litellm;"
POSTGRES16_PASSWORD=

# Admin UI login user is `admin`. The password is LITELLM_MASTER_KEY.
# UI:  https://litellm.sandbox.localhost/ui
# API: https://litellm.sandbox.localhost/v1
# LITELLM_SALT_KEY encrypts provider API keys stored in the database.
# Changing the salt makes previously stored provider keys unreadable.
# `make setup` fills empty values (32-byte hex). Leave them empty.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Client credential for every proxy model. The value starts with `sk-`.
# `make setup` fills an empty value. Leave it empty.
LITELLM_VIRTUAL_KEY=

# Provider keys for models in config.yaml. Set them in litellm/.env.
# An empty key still lets the container start. Calls to that provider fail until the key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

LITELLM_CPUS_LIMIT=1.0
LITELLM_MEMORY_LIMIT=2G
LITELLM_CPUS_RESERVED=0.1
LITELLM_MEMORY_RESERVED=256M
