RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# Temporal Versions
TEMPORAL_VERSION=latest
TEMPORAL_UI_VERSION=latest

# Temporal Server Configuration
TEMPORAL_GRPC_PORT=7233
TEMPORAL_CPUS_LIMIT=0.5
TEMPORAL_MEMORY_LIMIT=512M
TEMPORAL_CPUS_RESERVED=0.1
TEMPORAL_MEMORY_RESERVED=128M

# Temporal UI Configuration
TEMPORAL_UI_CPUS_LIMIT=0.25
TEMPORAL_UI_MEMORY_LIMIT=256M
TEMPORAL_UI_CPUS_RESERVED=0.05
TEMPORAL_UI_MEMORY_RESERVED=64M

# Opt-in Zitadel gateway via oauth2-proxy for Temporal UI only (not gRPC :7233).
# When enabling: AUTH_ENABLED=true and AUTH_MIDDLEWARE=auth-default (or auth-admin).
AUTH_ENABLED=false
AUTH_MIDDLEWARE=auth-none

# Database Configuration (Postgres)
# Using internal container name and port
DB=postgres12
POSTGRES_USER=postgres
POSTGRES_PWD=Password102!
POSTGRES_SEEDS=postgres

# Archival Configuration
TEMPORAL_ARCHIVAL_ENABLED=true
TEMPORAL_ARCHIVAL_RETENTION_DAYS=1
TEMPORAL_S3_ENDPOINT=http://minio:9000
TEMPORAL_S3_REGION=us-east-1
TEMPORAL_S3_BUCKET=temporal-archival
TEMPORAL_S3_ACCESS_KEY=admin
TEMPORAL_S3_SECRET_KEY=Password102!
