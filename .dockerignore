# Version control
.git
.gitignore

# Environment files and credentials
.env
.env.*
!.env.example
!**/.env.example

# Python and virtual environments
.venv
.ruff_cache
.mypy_cache
.pytest_cache
**/__pycache__
**/*.py[cod]
*$py.class

# IDE and OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Docker data, persistent volumes and runtime databases
**/data/
**/volumes/
**/*_data/
dockge/data/
dozzle/data/
supabase/volumes/db/data/
supabase/volumes/storage/

# Certificates and keys
traefik/certs/*.crt
traefik/certs/*.key
**/server.crt
**/server.key

# Logs and temporary files
*.log
logs/
*.tmp
tmp/
temp/

# Agent Relay artifacts
.agent-relay/
