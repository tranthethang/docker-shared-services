RESTART_POLICY=always
# Host port (container listens on 8090). Default 8140 avoids clash with Jenkins (8090).
POCKETBASE_PORT=8140
POCKETBASE_CPUS_LIMIT=0.25
POCKETBASE_MEMORY_LIMIT=256M
POCKETBASE_CPUS_RESERVED=0.05
POCKETBASE_MEMORY_RESERVED=64M
# Optional (muchobien image): bootstrap admin user on startup
# PB_ADMIN_EMAIL=admin@example.com
# PB_ADMIN_PASSWORD=password102
