# OTel Collector (OTLP endpoint for apps)
# Reserved host ports (unique across this repo):
#   4317 OTLP gRPC | 4318 OTLP HTTP | 3001 Grafana | 3100 Loki
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_COLLECTOR_MEM_LIMIT=512M
OTEL_COLLECTOR_CPU_LIMIT=0.25

# Grafana
GRAFANA_VERSION=11.4.0
GRAFANA_PORT=3001
GRAFANA_HOSTNAME=grafana.dss.localhost
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Password102!
GRAFANA_CPUS_LIMIT=0.50
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_CPUS_RESERVED=0.10
GRAFANA_MEMORY_RESERVED=128M

# Loki
LOKI_VERSION=3.3.2
LOKI_PORT=3100
LOKI_CPUS_LIMIT=0.50
LOKI_MEMORY_LIMIT=512M

# Promtail (Docker stdout -> Loki)
PROMTAIL_VERSION=3.3.2
PROMTAIL_CPUS_LIMIT=0.20
PROMTAIL_MEMORY_LIMIT=256M

# Restart Policy
RESTART_POLICY=always
