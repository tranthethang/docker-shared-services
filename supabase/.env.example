############
# Minimal Supabase stack (docker-shared-services)
# Services: supabase-db, supabase-auth, supabase-storage, realtime,
#           supabase-meta, supabase-studio, supabase-kong
#
# Setup:
#   1. cp .env.example .env
#   2. sh utils/generate-keys.sh --update-env
#   3. make up service=supabase   # or: sh run.sh start
#
############

RESTART_POLICY=always
COMPOSE_FILE=docker-compose.yml


############
# Secrets — change ALL defaults before first start
############

POSTGRES_PASSWORD=password102

# Legacy symmetric HS256 key (min 32 chars)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# Legacy API keys (HS256-signed JWTs) — replace via utils/generate-keys.sh
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Optional asymmetric keys (ES256) — generate with: sh utils/add-new-auth-keys.sh
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Legacy Kong basic-auth credentials (plugin disabled; Studio uses Authelia)
# Keep for optional re-enable — see volumes/api/kong.yml
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=password102

# Realtime Phoenix secret (min 64 chars; generate: openssl rand -base64 48)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
# Realtime DB field encryption (exactly 16 chars; generate: openssl rand -hex 8)
REALTIME_DB_ENC_KEY=supabaserealtime

# Studio ↔ postgres-meta encryption (min 32 chars)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Storage S3-protocol credentials
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907


############
# URLs (Traefik)
#   APIs:   https://supabase.localhost
#   Studio: https://studio.dss.localhost  (Authelia SSO)
############

SUPABASE_SUBDOMAIN=supabase
DOMAIN_NAME=localhost
SUPABASE_STUDIO_HOSTNAME=studio.dss.localhost
SUPABASE_PUBLIC_URL=https://supabase.localhost
API_EXTERNAL_URL=https://supabase.localhost/auth/v1
SITE_URL=https://supabase.localhost


############
# Database (container-internal; host publish is SUPABASE_DB_PORT)
############

POSTGRES_HOST=supabase-db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Host port — avoids pgvector:5432 and postgres16:5433
SUPABASE_DB_PORT=5434


############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=


############
# Auth
############

ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Mailpit (make up service=mailpit) on shared networks
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=supabase
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true


############
# Storage (file backend under ./volumes/storage)
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Kong host ports (container listens 8000/8443)
# 8002 avoids ChromaDB 8000; 8445 avoids Appsmith 8444
############

SUPABASE_KONG_HTTP_PORT=8002
SUPABASE_KONG_HTTPS_PORT=8445

ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# Resource limits
############

SUPABASE_STUDIO_CPUS_LIMIT=0.5
SUPABASE_STUDIO_MEMORY_LIMIT=512M
SUPABASE_STUDIO_CPUS_RESERVED=0.1
SUPABASE_STUDIO_MEMORY_RESERVED=128M

SUPABASE_KONG_CPUS_LIMIT=0.5
SUPABASE_KONG_MEMORY_LIMIT=512M
SUPABASE_KONG_CPUS_RESERVED=0.1
SUPABASE_KONG_MEMORY_RESERVED=128M

SUPABASE_AUTH_CPUS_LIMIT=0.25
SUPABASE_AUTH_MEMORY_LIMIT=256M
SUPABASE_AUTH_CPUS_RESERVED=0.05
SUPABASE_AUTH_MEMORY_RESERVED=64M

SUPABASE_STORAGE_CPUS_LIMIT=0.5
SUPABASE_STORAGE_MEMORY_LIMIT=512M
SUPABASE_STORAGE_CPUS_RESERVED=0.1
SUPABASE_STORAGE_MEMORY_RESERVED=128M

SUPABASE_REALTIME_CPUS_LIMIT=0.5
SUPABASE_REALTIME_MEMORY_LIMIT=512M
SUPABASE_REALTIME_CPUS_RESERVED=0.1
SUPABASE_REALTIME_MEMORY_RESERVED=128M

SUPABASE_META_CPUS_LIMIT=0.25
SUPABASE_META_MEMORY_LIMIT=256M
SUPABASE_META_CPUS_RESERVED=0.05
SUPABASE_META_MEMORY_RESERVED=64M

SUPABASE_DB_CPUS_LIMIT=1
SUPABASE_DB_MEMORY_LIMIT=1G
SUPABASE_DB_CPUS_RESERVED=0.25
SUPABASE_DB_MEMORY_RESERVED=256M
