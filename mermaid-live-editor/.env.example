RESTART_POLICY=always
# Host port (container nginx listens on 8080). Default 8160 avoids clash with Traefik/Adminer/Kafka/Temporal.
MERMAID_LIVE_EDITOR_PORT=8160
MERMAID_LIVE_EDITOR_CPUS_LIMIT=1.0
MERMAID_LIVE_EDITOR_MEMORY_LIMIT=512M
MERMAID_LIVE_EDITOR_CPUS_RESERVED=0.1
MERMAID_LIVE_EDITOR_MEMORY_RESERVED=128M
