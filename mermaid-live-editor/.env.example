RESTART_POLICY=unless-stopped
MERMAID_LIVE_EDITOR_CPUS_LIMIT=0.5
MERMAID_LIVE_EDITOR_MEMORY_LIMIT=512M
MERMAID_LIVE_EDITOR_CPUS_RESERVED=0.1
MERMAID_LIVE_EDITOR_MEMORY_RESERVED=128M

# Opt-in Zitadel gateway via oauth2-proxy (disabled by default).
# When enabling: AUTH_ENABLED=true and AUTH_MIDDLEWARE=auth-default (or auth-admin).
AUTH_ENABLED=false
AUTH_MIDDLEWARE=auth-none
