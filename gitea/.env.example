RESTART_POLICY=unless-stopped
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
# Public URL (HTTPS via Traefik). Applied on every start via environment-to-ini, including
# existing gitea_data volumes. Webhook/OAuth URLs already stored in the database are NOT rewritten.
GITEA_ROOT_URL=https://gitea.dss.localhost/
POSTGRES16_HOST=postgres
POSTGRES16_PORT=5432
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=
GITEA_CPUS_LIMIT=0.5
GITEA_MEMORY_LIMIT=512M
GITEA_CPUS_RESERVED=0.1
GITEA_MEMORY_RESERVED=128M
