RESTART_POLICY=unless-stopped

# Inngest Security Keys (Required)
# Event key used to authenticate incoming event requests.
# Signing key used to verify signatures between Inngest and your SDKs.
# Even-length hex strings; make setup generates 16 hex characters.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Hostname of Postgres on data_net (service/container name).
# Use "postgres" for postgres/docker-compose.yml, or "pgvector" for pgvector/docker-compose.yml.
POSTGRES16_HOST=postgres
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=
POSTGRES16_DB=inngest

# Hostname and credentials of Redis on data_net
REDIS_HOST=redis
REDIS_PASSWORD=

# Resource Limits
INNGEST_CPUS_LIMIT=0.5
INNGEST_MEMORY_LIMIT=512M
INNGEST_CPUS_RESERVED=0.1
INNGEST_MEMORY_RESERVED=128M

# Optional serve URL Inngest pulls on startup. Leave empty so the server
# starts with no app; the SDK push-syncs when the app is up.
# Do not use the short name "api" — other stacks may publish that DNS name
# on backend_net. Example for the audiobook hub:
# INNGEST_SDK_URL=http://tts-audiobook-api-hub:8000/api/inngest
INNGEST_SDK_URL=
