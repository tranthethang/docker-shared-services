RESTART_POLICY=always
INNGEST_PORT=8288

# Inngest Security Keys (Required)
# Event key used to authenticate incoming event requests.
# Signing key used to verify signatures between Inngest and your SDKs.
# Must be hex strings with even number of characters (e.g. 32-character hex).
INNGEST_EVENT_KEY=00000000000000000000000000000000
INNGEST_SIGNING_KEY=00000000000000000000000000000000

# Hostname of Postgres on the infra_shared network (service/container name).
# Use "postgres" for postgres/docker-compose.yml, or "pgvector" for pgvector/docker-compose.yml.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password102
POSTGRES_DB=inngest

# Hostname and credentials of Redis on the infra_shared network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password102

# Resource Limits
INNGEST_CPUS_LIMIT=0.5
INNGEST_MEMORY_LIMIT=512M
INNGEST_CPUS_RESERVED=0.1
INNGEST_MEMORY_RESERVED=128M
