############################################################
# Woodpecker CI
############################################################

# Host ports
WOODPECKER_HTTP_PORT=8012

# Traefik host (for browser + OAuth callback)
WOODPECKER_SUBDOMAIN=woodpecker

# Security
# IMPORTANT: Set a strong shared secret. Must match on server + agent.
WOODPECKER_AGENT_SECRET=change_me

# Optional: initial admin users (comma-separated, match your forge username)
WOODPECKER_ADMIN=

# Logging
WOODPECKER_LOG_LEVEL=info

# Resource limits (optional)
WOODPECKER_CPUS_LIMIT=0.5
WOODPECKER_MEMORY_LIMIT=512M
WOODPECKER_CPUS_RESERVED=0.1
WOODPECKER_MEMORY_RESERVED=128M

WOODPECKER_AGENT_CPUS_LIMIT=0.5
WOODPECKER_AGENT_MEMORY_LIMIT=512M
WOODPECKER_AGENT_CPUS_RESERVED=0.1
WOODPECKER_AGENT_MEMORY_RESERVED=128M

# Gitea integration
# Create an OAuth2 application in Gitea:
# - Callback URL: https://woodpecker.localhost/authorize
WOODPECKER_GITEA=true
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# GitHub integration
# Create an OAuth app in GitHub:
# - Callback URL: https://woodpecker.localhost/authorize
WOODPECKER_GITHUB=false
WOODPECKER_GITHUB_URL=https://github.com
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# GitLab integration
# Create an OAuth app in GitLab:
# - Redirect URI: https://woodpecker.localhost/authorize
WOODPECKER_GITLAB=false
WOODPECKER_GITLAB_URL=https://gitlab.com
WOODPECKER_GITLAB_CLIENT=
WOODPECKER_GITLAB_SECRET=
