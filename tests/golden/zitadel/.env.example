# Docker Shared Services - Global Environment Configuration
# Copy this file to .env and customize for your environment

# Common Settings
# unless-stopped: respects manual `docker stop` across daemon restarts.
RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# =============================================================================
# SHARED PASSWORD (written by `make setup` / `make passwords`)
# =============================================================================
# ONE value is applied to Postgres/MySQL/Redis/MinIO/Grafana/… password fields.
# Leave empty so the first `make setup` generates a random password.
# - Random (default):  make setup
# - Choose one:        make setup password='your-secure-password'
#                      DSS_SHARED_PASSWORD='your-secure-password' make setup
# Leave password fields below empty; setup fills them. Rotate later with:
#                      make passwords password='New-Strong.Password1' force=1
#                      (see "Rotate the shared password" in docs/troubleshooting.md)
# Unique secrets (Garage RPC/admin, Woodpecker agent, Zitadel masterkey) stay separate.
DSS_SHARED_PASSWORD=

# =============================================================================
# TRAEFIK - Reverse Proxy & Load Balancer
# =============================================================================
LETSENCRYPT_EMAIL=admin@example.com
# Traefik host ports (80/443) are bound to 127.0.0.1 in compose — local only.
LOG_LEVEL=INFO
TRAEFIK_CPUS_LIMIT=0.25
TRAEFIK_MEMORY_LIMIT=128M
TRAEFIK_CPUS_RESERVED=0.05
TRAEFIK_MEMORY_RESERVED=32M
# Traefik dashboard BasicAuth (admin + DSS_SHARED_PASSWORD, generated by make setup).
# If setting a custom htpasswd hash, double every $ for Docker Compose.
TRAEFIK_DASHBOARD_AUTH=

# =============================================================================
# POSTGRES - PostgreSQL 16 (DEFAULT shared backend)
# Starts by default and is the database other services connect to
# (gitea, jenkins, concourse, sonarqube, zitadel, inngest, bugsink, temporal,
# hasura all default their POSTGRES16_HOST to "postgres" / port 5432).
# =============================================================================
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=
POSTGRES16_DB=postgres_db
POSTGRES16_PORT=5432
POSTGRES16_CPUS_LIMIT=0.5
POSTGRES16_MEMORY_LIMIT=512M
POSTGRES16_CPUS_RESERVED=0.1
POSTGRES16_MEMORY_RESERVED=128M

# =============================================================================
# Security Notes
# =============================================================================
# ⚠️  IMPORTANT: Change all default passwords before deploying to production!
# Generated passwords should be at least 32 characters long.
# Use: openssl rand -base64 32
#
# Password recommendations:
# - Database passwords: Strong, 32+ characters
# - API tokens/keys: Unique, no reuse across services
# - Admin credentials: Follow principle of least privilege
# =============================================================================
