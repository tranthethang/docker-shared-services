# Kafka Configuration
KAFKA_CPUS_LIMIT=1
KAFKA_MEMORY_LIMIT=1G
KAFKA_CPUS_RESERVED=0.25
KAFKA_MEMORY_RESERVED=256M

# Kafka UI Configuration
KAFKA_UI_CPUS_LIMIT=0.25
KAFKA_UI_MEMORY_LIMIT=256M
KAFKA_UI_CPUS_RESERVED=0.05
KAFKA_UI_MEMORY_RESERVED=64M

# Kafka KRaft Mode
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Restart Policy
RESTART_POLICY=unless-stopped

# Opt-in Zitadel gateway via oauth2-proxy for Kafka UI (disabled by default).
# When enabling: AUTH_ENABLED=true and AUTH_MIDDLEWARE=auth-default (or auth-admin).
AUTH_ENABLED=false
AUTH_MIDDLEWARE=auth-none
