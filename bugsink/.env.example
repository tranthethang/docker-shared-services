RESTART_POLICY=always
BUGSINK_PORT=8150

# Django secret key — generate with: openssl rand -base64 50
BUGSINK_SECRET_KEY=change-me-generate-with-openssl-rand-base64-50

# Initial admin account (email:password). Remove after first start to avoid resetting on restart.
BUGSINK_CREATE_SUPERUSER=admin@example.org:admin

# Public URL (used for links in emails/alerts). Traefik serves https://bugsink.localhost.
BUGSINK_BASE_URL=https://bugsink.localhost
BUGSINK_BEHIND_HTTPS_PROXY=true
BUGSINK_USE_X_FORWARDED_HOST=true

# Shared PostgreSQL 16 on infra_shared (postgres/docker-compose.yml).
# Create the database once: docker exec postgres psql -U postgres -c "CREATE DATABASE bugsink;"
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password102
POSTGRES_DB=bugsink

BUGSINK_CPUS_LIMIT=0.5
BUGSINK_MEMORY_LIMIT=512M
BUGSINK_CPUS_RESERVED=0.1
BUGSINK_MEMORY_RESERVED=128M
