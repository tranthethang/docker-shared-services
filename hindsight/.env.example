RESTART_POLICY=always

# Traefik hostnames (HTTPS only — no host port publish for this service).
# API + MCP: https://hindsight.dss.localhost
# Control-plane UI: https://hindsight-ui.dss.localhost
# MCP endpoint example: https://hindsight.dss.localhost/mcp/<bank_id>/
HINDSIGHT_HOSTNAME=hindsight.dss.localhost
HINDSIGHT_UI_HOSTNAME=hindsight-ui.dss.localhost
HINDSIGHT_PUBLIC_URL=https://hindsight.dss.localhost
HINDSIGHT_UI_PUBLIC_URL=https://hindsight-ui.dss.localhost

# Shared PgVector (PostgreSQL 17) on infra_shared.
# Bootstrap once (Bugsink-style):
#   docker exec pgvector psql -U postgres -c "CREATE DATABASE hindsight;"
#   docker exec pgvector psql -U postgres -d hindsight -c "CREATE EXTENSION IF NOT EXISTS vector;"
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Password102!
POSTGRES_DB=hindsight

# LLM provider (required for retain/recall). Default: OpenAI Chat Completions.
# Any OpenAI-compatible proxy works (9router, LiteLLM, Azure OpenAI, vLLM, …):
#   HINDSIGHT_API_LLM_PROVIDER=openai
#   HINDSIGHT_API_LLM_BASE_URL=https://your-proxy.example.com/v1
#   HINDSIGHT_API_LLM_API_KEY=sk-xxxx
#   HINDSIGHT_API_LLM_MODEL=model-name-on-proxy
# Use provider=openai-responses if the proxy only exposes /v1/responses.
# Optional JSON headers for gateways: HINDSIGHT_API_LLM_DEFAULT_HEADERS={"X-Foo":"bar"}
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_BASE_URL=
# Optional JSON object of extra HTTP headers for the LLM client (gateways).
# Leave empty — compose defaults to JSON null. Example:
# HINDSIGHT_API_LLM_DEFAULT_HEADERS={"X-Title":"dss-hindsight"}
HINDSIGHT_API_LLM_DEFAULT_HEADERS=

# Embeddings + reranker (defaults match slim image + Voyage via LiteLLM SDK).
# Text embedding models only — voyage-multimodal-* is a different API.
# Docs: https://docs.voyageai.com/docs/embeddings
#       https://docs.voyageai.com/docs/reranker
HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm-sdk
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_API_KEY=
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_MODEL=voyage/voyage-4-lite
# Empty omits encoding_format (required for Voyage / Gemini via LiteLLM).
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_ENCODING_FORMAT=

HINDSIGHT_API_RERANKER_PROVIDER=litellm-sdk
HINDSIGHT_API_RERANKER_LITELLM_SDK_API_KEY=
HINDSIGHT_API_RERANKER_LITELLM_SDK_MODEL=voyage/rerank-2.5-lite

# Stable worker identity across container restarts.
HINDSIGHT_API_WORKER_ID=hindsight-dss

# Control plane → API (same container; leave default unless splitting services).
HINDSIGHT_CP_DATAPLANE_API_URL=http://127.0.0.1:8888

# Resource limits (slim + remote providers). Use ~2G / shm 1g for the full image.
HINDSIGHT_CPUS_LIMIT=1
HINDSIGHT_MEMORY_LIMIT=1G
HINDSIGHT_CPUS_RESERVED=0.25
HINDSIGHT_MEMORY_RESERVED=256M
HINDSIGHT_SHM_SIZE=256m

TZ=Asia/Ho_Chi_Minh
