RESTART_POLICY=always
TZ=UTC

# Traefik host — must stay under *.dss.localhost (Authelia rejects bare "localhost" cookies)
AUTHELIA_HOSTNAME=auth.dss.localhost

# Host port (optional direct access without Traefik)
AUTHELIA_PORT=9091

# Secrets — replace before use (must be at least 64 characters each):
#   docker run --rm authelia/authelia:4.39.4 authelia crypto rand --length 64 --charset alphanumeric
AUTHELIA_JWT_SECRET=changeme_generate_with_authelia_crypto_rand_jwt_secret_min_64_chars_xx
AUTHELIA_SESSION_SECRET=changeme_generate_with_authelia_crypto_rand_session_secret_min_64_xx
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme_generate_with_authelia_crypto_rand_storage_key_min_64_xx

# Resource limits
AUTHELIA_CPUS_LIMIT=0.5
AUTHELIA_MEMORY_LIMIT=256M
AUTHELIA_CPUS_RESERVED=0.05
AUTHELIA_MEMORY_RESERVED=64M
