RESTART_POLICY=always
TZ=UTC

# Traefik host — must stay under *.dss.localhost (Authelia rejects bare "localhost" cookies)
AUTHELIA_HOSTNAME=auth.dss.localhost

# Host port (optional direct access without Traefik)
AUTHELIA_PORT=9091

# Secrets — generate for anything beyond local dev:
#   docker run --rm authelia/authelia:4.39.4 authelia crypto rand --length 64 --charset alphanumeric
# Must be at least 64 characters each.
AUTHELIA_JWT_SECRET=nHSviYAgpepHrVUEMWYN0Zm43y395gyJp5dh21olQhHjeSJJXDvqPQvQOKN75e5
AUTHELIA_SESSION_SECRET=wguaYUhQFOIoLwk6CSPoWvOlw4SD4WBh8s1AUyu2zB6JZwu1gxX0rrV0LTSQmtni
AUTHELIA_STORAGE_ENCRYPTION_KEY=KVNP6VieCQyuVjuSdgegiLKKJ4anJyOxGbsZChvSbWup8WiuxT7gNRuVihahJ0em

# Resource limits
AUTHELIA_CPUS_LIMIT=0.5
AUTHELIA_MEMORY_LIMIT=256M
AUTHELIA_CPUS_RESERVED=0.05
AUTHELIA_MEMORY_RESERVED=64M
