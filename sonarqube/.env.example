RESTART_POLICY=always
SONARQUBE_PORT=9000

# Hostname of Postgres on the dev_tools network (service/container name).
# Use "postgres" for postgres/docker-compose.yml, or "pgvector" for pgvector/docker-compose.yml.
POSTGRES_HOST=postgres
# Port inside the Docker network (usually 5432). Not the host-mapped port from docker-compose port publishing.
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password102
POSTGRES_DB=sonarqube

SONARQUBE_CPUS_LIMIT=2
SONARQUBE_MEMORY_LIMIT=2G
SONARQUBE_CPUS_RESERVED=1
SONARQUBE_MEMORY_RESERVED=1G

# SonarQube MCP Server (AI agents / IDE) is configured on the client side (Cursor, Claude, etc.),
# not via env vars here. Point SONARQUBE_URL at this server (e.g. http://localhost:9000) and use a user token.
# See: https://docs.sonarsource.com/sonarqube-mcp-server/
