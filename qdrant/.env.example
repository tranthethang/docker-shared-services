RESTART_POLICY=unless-stopped


# API key for REST/gRPC (send as api-key header). Change for non-local use.
# Prefer this native key for API clients; Traefik Zitadel gateway stays off by default.
QDRANT_API_KEY=Password102!

# Opt-in Zitadel gateway via oauth2-proxy (disabled by default; prefer QDRANT_API_KEY for APIs).
# When enabling: AUTH_ENABLED=true and AUTH_MIDDLEWARE=auth-default (or auth-admin).
AUTH_ENABLED=false
AUTH_MIDDLEWARE=auth-none

QDRANT_LOG_LEVEL=INFO
QDRANT_TELEMETRY_DISABLED=true

QDRANT_CPUS_LIMIT=0.5
QDRANT_MEMORY_LIMIT=512M
QDRANT_CPUS_RESERVED=0.1
QDRANT_MEMORY_RESERVED=128M
