RESTART_POLICY=always

# Host ports (container listens on 6333 REST / 6334 gRPC). Defaults match Qdrant upstream.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# API key for REST/gRPC (send as api-key header). Change for non-local use.
QDRANT_API_KEY=password102

QDRANT_LOG_LEVEL=INFO
QDRANT_TELEMETRY_DISABLED=true

QDRANT_CPUS_LIMIT=1
QDRANT_MEMORY_LIMIT=1G
QDRANT_CPUS_RESERVED=0.1
QDRANT_MEMORY_RESERVED=256M
