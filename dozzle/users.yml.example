users:
  admin:
    # Optional: used to generate Gravatar avatars
    email: admin@example.com
    name: Admin
    # Password must be a bcrypt hash (generated by `amir20/dozzle generate`).
    password: "<bcrypt-hash>"
    # Optional: can restrict which containers the user can see
    filter: ""
    # Optional: roles like `shell`, `actions`, `download`, `all`, ...
    roles: ""
