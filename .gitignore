# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.*.local
.env.test

# --- Docker Data & Volumes (Global) ---
**/data/
**/volumes/
**/.docker/
**/*_data/
**/jenkins_home/
**/sonarqube_*/

# --- Specific Service Data ---
postgres_data/
mysql_data/
mongodb_data/
redis_data/
rabbitmq_data/
gitea_data/
act_runner_data/
minio_data/
concourse_data/
redisinsight_data/

# --- Logs & Temp ---
*.log
logs/
*.tmp
tmp/
temp/

# --- Database Backups ---
*.sql
*.sql.gz
*.bak
*.backup

# --- IDE & OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Python / uv ---
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
**/__pycache__/
*.py[cod]
*$py.class

# --- Certificates ---
**/server.crt
**/server.key
traefik/certs/*.crt
traefik/certs/*.key
!traefik/certs/.gitkeep

# --- Dozzle auth + data (generated) ---
dozzle/data/
!dozzle/data/.gitkeep

# --- Docker Build Artifacts ---
/dist/
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.lock

# ==========================================
# KEEP RULES (do not drop important files)
# ==========================================

# Keep example env files
!.env.example
!**/.env.example

# Keep Docker Compose configuration
!docker-compose*.yml
!**/docker-compose.yml
!docker-compose.shared.yml

# Keep scripts and documentation
!start-services.sh
!setup-env.sh
!Makefile
!*.md
!LICENSE

# Keep Python sources in bin/
!bin/*.py

# Supabase: track Kong + init SQL (not runtime data/storage)
# Overrides **/volumes/ and *.sql above
!supabase/volumes/
!supabase/volumes/api/
!supabase/volumes/api/**
!supabase/volumes/db/
!supabase/volumes/db/*.sql
!supabase/volumes/snippets/
!supabase/volumes/snippets/.gitkeep
supabase/volumes/db/data/
supabase/volumes/storage/

.zencoder/
.zenflow/
