RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# Registry and admin account
VERDACCIO_PORT=4873
VERDACCIO_HOSTNAME=verdaccio.dss.localhost
VERDACCIO_USER=admin
VERDACCIO_PASSWORD=

# Optional authenticated uplinks
VERDACCIO_GITHUB_TOKEN=
VERDACCIO_GITLAB_URL=https://gitlab.com/api/v4/packages/npm/
VERDACCIO_GITLAB_TOKEN=
VERDACCIO_INTERNAL_URL=
VERDACCIO_INTERNAL_TOKEN=

# Comma-separated package scopes; GitHub, GitLab, and internal are applied in order
VERDACCIO_GITHUB_SCOPES=
VERDACCIO_GITLAB_SCOPES=
VERDACCIO_INTERNAL_SCOPES=

# Resource Limits
VERDACCIO_CPUS_LIMIT=0.5
VERDACCIO_MEMORY_LIMIT=512M
VERDACCIO_CPUS_RESERVED=0.1
VERDACCIO_MEMORY_RESERVED=128M
