# Extra ignore patterns for ripgrep and fd, on top of .gitignore.

# Local virtualenv
.venv/

# Local agent-relay runs are gitignored globally and are not source.
.agent-relay/

# Generated / runtime data
**/data/
**/volumes/
**/.docker/
**/*_data/
**/jenkins_home/
**/sonarqube_*/

# Secrets & machine-local env (format .env.example only)
.env
.env.local
.env.production
.env.*.local
.env.test

# Certs & ACME state
**/server.crt
**/server.key
traefik/certs/
traefik/acme.json

# Logs / backups / OS
*.log
logs/
*.tmp
tmp/
temp/
*.sql
*.sql.gz
*.bak
*.backup
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.zencoder/
.zenflow/
