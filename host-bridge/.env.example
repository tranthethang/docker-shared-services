RESTART_POLICY=unless-stopped
# Upstream hostnames use ${SANDBOX_NAME:+${SANDBOX_NAME}-}<container> (see USAGE.md).
# Port variables match the root `.env` defaults so Mac clients keep the same aliases.
POSTGRES16_PORT=5432
PGVECTOR_PORT=5433
SUPABASE_DB_PORT=5434
MYSQL_PORT=3306
MARIADB_PORT=3307
MONGO_PORT=27017
REDIS_PORT=6379
MEMCACHED_PORT=11211
RABBITMQ_PORT=5672
MAILPIT_SMTP_PORT=1025
HOST_BRIDGE_CPUS_LIMIT=0.25
HOST_BRIDGE_MEMORY_LIMIT=128M
HOST_BRIDGE_CPUS_RESERVED=0.05
HOST_BRIDGE_MEMORY_RESERVED=32M
