RESTART_POLICY=always
TZ=Asia/Ho_Chi_Minh

# --- Secrets (required, no defaults) ---
# RPC secret shared between garage nodes. Generate with:
#   openssl rand -hex 32
GARAGE_RPC_SECRET=

# Bearer token for the admin API (bucket/key management, layout, health...). Generate with:
#   openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Bearer token for the Prometheus /metrics endpoint. Leave empty to reuse GARAGE_ADMIN_TOKEN.
GARAGE_METRICS_TOKEN=

# --- Ports ---
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903

# --- Resources ---
GARAGE_CPUS_LIMIT=1
GARAGE_MEMORY_LIMIT=1G
GARAGE_CPUS_RESERVED=0.5
GARAGE_MEMORY_RESERVED=512M
