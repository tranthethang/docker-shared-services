POCKETBASE_CPUS_LIMIT=0.25
POCKETBASE_MEMORY_LIMIT=256M
POCKETBASE_CPUS_RESERVED=0.05
POCKETBASE_MEMORY_RESERVED=64M

# =============================================================================
# CENTRIFUGO - Real-time messaging (WebSocket, SSE)
# =============================================================================
JWT_SIGNING_KEY=password102
