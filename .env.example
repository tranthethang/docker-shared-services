# Docker Shared Services - Global Environment Configuration
# Copy this file to .env and customize for your environment

# Common Settings
RESTART_POLICY=always
TZ=Asia/Ho_Chi_Minh

# =============================================================================
# TRAEFIK - Reverse Proxy & Load Balancer
# =============================================================================
LETSENCRYPT_EMAIL=admin@example.com
LOG_LEVEL=DEBUG
TRAEFIK_CPUS_LIMIT=0.25
TRAEFIK_MEMORY_LIMIT=256M
TRAEFIK_CPUS_RESERVED=0.05
TRAEFIK_MEMORY_RESERVED=64M

# =============================================================================
# PGVECTOR - PostgreSQL 17 with Vector Extension
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password102
POSTGRES_DB=sonarqube
POSTGRES_PORT=5432
POSTGRES_CPUS_LIMIT=0.5
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_CPUS_RESERVED=0.1
POSTGRES_MEMORY_RESERVED=128M

# =============================================================================
# POSTGRES - PostgreSQL 16
# =============================================================================
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=password102
POSTGRES16_DB=postgres_db
POSTGRES16_PORT=5432
POSTGRES16_CPUS_LIMIT=0.5
POSTGRES16_MEMORY_LIMIT=512M
POSTGRES16_CPUS_RESERVED=0.1
POSTGRES16_MEMORY_RESERVED=128M

