CENTRIFUGO_CPUS_LIMIT=0.25
CENTRIFUGO_MEMORY_LIMIT=64M
CENTRIFUGO_CPUS_RESERVED=0.05
CENTRIFUGO_MEMORY_RESERVED=16M

# =============================================================================
# GOTENBERG - PDF conversion API (Chromium, LibreOffice, PDF engines)
# =============================================================================
GOTENBERG_API_PORT=3030
GOTENBERG_CPUS_LIMIT=1
GOTENBERG_MEMORY_LIMIT=1G
GOTENBERG_CPUS_RESERVED=0.1
GOTENBERG_MEMORY_RESERVED=256M

# =============================================================================
# Security Notes
# =============================================================================
# ⚠️  IMPORTANT: Change all default passwords before deploying to production!
# Generated passwords should be at least 32 characters long.
# Use: openssl rand -base64 32
#
# Password recommendations:
# - Database passwords: Strong, 32+ characters
# - API tokens/keys: Unique, no reuse across services
# - Admin credentials: Follow principle of least privilege
# =============================================================================
