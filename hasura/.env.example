RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# Pin Hasura GraphQL Engine version (https://github.com/hasura/graphql-engine)
HASURA_VERSION=v2.50.3

# Default: hasura.${DOMAIN}
HASURA_HOSTNAME=

# Console / dev defaults (disable for non-local use)
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
# Comma-separated Hasura log categories (http-log, query-log, …). Empty = warnings/errors only.
HASURA_GRAPHQL_ENABLED_LOG_TYPES=
HASURA_GRAPHQL_ADMIN_SECRET=
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=anonymous

# Shared PostgreSQL 16 on data_net (postgres/docker-compose.yml).
# Database `hasura` is created by postgres/bin/init.sh on postgres start.
POSTGRES16_HOST=postgres
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=
POSTGRES16_DB=hasura

# Resource Limits
HASURA_CPUS_LIMIT=0.5
HASURA_MEMORY_LIMIT=512M
HASURA_CPUS_RESERVED=0.1
HASURA_MEMORY_RESERVED=128M
