RESTART_POLICY=always

# Pin API + Login UI to the same major/minor (bump together when upgrading)
ZITADEL_VERSION=v4.16.3

ZITADEL_HOSTNAME=zitadel.dss.localhost
# Host port mapped to container 8080 — 8180 avoids Traefik dashboard on 8080
ZITADEL_PORT=8180

# Masterkey must be exactly 32 characters (cannot change after first init without data loss)
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# Must satisfy complexity: upper, lower, number, symbol
ZITADEL_ADMIN_PASSWORD=Password102!
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

POSTGRES16_HOST=postgres
POSTGRES16_PORT=5432
POSTGRES16_USER=postgres
POSTGRES16_PASSWORD=password102
POSTGRES16_DB=zitadel

ZITADEL_CPUS_LIMIT=1
ZITADEL_MEMORY_LIMIT=1G
ZITADEL_CPUS_RESERVED=0.2
ZITADEL_MEMORY_RESERVED=256M

ZITADEL_LOGIN_CPUS_LIMIT=0.5
ZITADEL_LOGIN_MEMORY_LIMIT=512M
ZITADEL_LOGIN_CPUS_RESERVED=0.1
ZITADEL_LOGIN_MEMORY_RESERVED=128M

# Optional Redis caching (disabled by default). After `make up service=redis`:
#   1. Set ENABLED=true and connectors below
#   2. make restart service=zitadel
ZITADEL_CACHES_CONNECTORS_REDIS_ENABLED=false
ZITADEL_CACHES_CONNECTORS_REDIS_URL=redis://:password102@redis:6379/0
# ZITADEL_CACHES_INSTANCE_CONNECTOR=redis
# ZITADEL_CACHES_MILESTONES_CONNECTOR=redis
# ZITADEL_CACHES_ORGANIZATION_CONNECTOR=redis
