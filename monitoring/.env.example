# Monitoring Stack Configuration

# Image Versions
GRAFANA_VERSION=11.4.0
LOKI_VERSION=3.1.1
PROMTAIL_VERSION=3.1.1

# Ports
GRAFANA_PORT=3001
LOKI_PORT=3100

# Traefik Configuration
GRAFANA_HOSTNAME=grafana.localhost

# Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password102

# Resource Limits - Grafana
GRAFANA_CPUS_LIMIT=0.50
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_CPUS_RESERVED=0.25
GRAFANA_MEMORY_RESERVED=256M

# Resource Limits - Loki
LOKI_CPUS_LIMIT=0.50
LOKI_MEMORY_LIMIT=512M

# Resource Limits - Promtail
PROMTAIL_CPUS_LIMIT=0.20
PROMTAIL_MEMORY_LIMIT=256M

# Restart Policy
RESTART_POLICY=always
