RESTART_POLICY=unless-stopped

# Pin together when upgrading
OAUTH2_PROXY_VERSION=v7.12.0

# Default: auth.${DOMAIN}
OAUTH2_PROXY_HOSTNAME=
# Issuer base URL (origin plus path), not the .well-known URL; e.g. https://idp.dss.localhost/api/auth
OAUTH2_PROXY_OIDC_ISSUER_URL=
# Set only for a local issuer reached through this machine's Traefik; leave empty for public issuers.
OAUTH2_PROXY_OIDC_ISSUER_HOST=
# Default: https://auth.${DOMAIN}/oauth2/callback
OAUTH2_PROXY_REDIRECT_URL=

# Register a confidential OIDC client with the issuer using the redirect URI above.
# Leave empty until registered — `make setup` will not invent these.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Local cookie encryption key (16, 24, or 32 characters). Filled by `make setup` when empty.
OAUTH2_PROXY_COOKIE_SECRET=

# Default: .${DOMAIN}
OAUTH2_PROXY_COOKIE_DOMAINS=
# Default: .${DOMAIN}
OAUTH2_PROXY_WHITELIST_DOMAINS=
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_SCOPE=openid profile email

OAUTH2_PROXY_CPUS_LIMIT=0.5
OAUTH2_PROXY_MEMORY_LIMIT=256M
OAUTH2_PROXY_CPUS_RESERVED=0.1
OAUTH2_PROXY_MEMORY_RESERVED=64M
